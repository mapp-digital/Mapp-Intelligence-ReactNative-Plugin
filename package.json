{
  "name": "mapp-intelligence-reactnative-plugin",
  "version": "2.0.0",
  "description": "The MappIntelligence SDK allows you to track user activities, screen flow and media usage for an App. All data is send to the MappIntelligence tracking system for further analysis.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "app.plugin.js",
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-mappinteligence-plugin-example",
    "start": "react-native start",
    "install:high-mem": "NODE_OPTIONS=--max-old-space-size=8192 yarn install",
    "plugin:local": "node scripts/set-example-plugin-source.js local",
    "plugin:published": "node scripts/set-example-plugin-source.js published",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "release-it",
    "test:expo-plugin": "node --test scripts/test-expo-config-plugin.cjs",
    "test:package": "node scripts/verify-package-artifact.cjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapp-digital/Mapp-Intelligence-ReactNative-Plugin.git"
  },
  "author": "Mapp Digital <stefan.stevanovic@mapp.com> (https://github.com/StefanMiticon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mapp-digital/Mapp-Intelligence-ReactNative-Plugin/issues"
  },
  "homepage": "https://github.com/mapp-digital/Mapp-Intelligence-ReactNative-Plugin#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.84.0 <0.86.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.1.0",
    "@react-native/codegen": "0.84.1",
    "@react-native/gradle-plugin": "0.84.1",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.35.3",
    "react-native-webview": "^13.13.5",
    "typescript": "^5.0.0"
  },
  "resolutions": {
    "@types/react": "^19.2.0"
  },
  "workspaces": [
    "example",
    "."
  ],
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "cliVersion": "0.50.3"
  },
  "codegenConfig": {
    "name": "MappinteligencePlugin",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mappinteligenceplugin"
    }
  }
}
