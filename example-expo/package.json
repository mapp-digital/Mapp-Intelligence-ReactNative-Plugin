    "test:integration": "maestro test .maestro/smoke.yaml"
  },
  "dependencies": {
    "expo": "56.0.0",
    "expo-dev-client": "56.0.26",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-webview": "13.16.1",
    "mapp-intelligence-reactnative-plugin": "file:..",
    "expo-build-properties": "56.0.27"
  }
}
